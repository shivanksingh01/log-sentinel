		{
			"name": "App Simulators (Demo Endpoints)",
			"item": [
				{
					"name": "Login (Trigger BRUTE_FORCE/CREDENTIAL_STUFFING)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"wrongpassword\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Attempt authentication. By intentionally failing, you trigger LogSentinel's Brute Force or Credential Stuffing rules."
					},
					"response": []
				},
				{
					"name": "Get Products (Trigger REQUEST)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"products"
							]
						},
						"description": "Fetch available products."
					},
					"response": []
				},
				{
					"name": "Admin Area (Trigger FORBIDDEN_ACCESS)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin"
							]
						},
						"description": "Attempt to access the protected admin area. Always returns 403, useful for triggering suspicious access alerts in LogSentinel."
					},
					"response": []
				}
			]
		}
