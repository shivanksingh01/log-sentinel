# -------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# -------------------------------------------------------------------
# External Integrations (Optional)
# -------------------------------------------------------------------
# Set to true to enable webhook forwarding of alerts
WEBHOOK_ENABLED=false
WEBHOOK_URL=http://localhost:3000/api/mock/webhook

# -------------------------------------------------------------------
# Detection Engine Tuning (Optional — sensible defaults built in)
# -------------------------------------------------------------------

# Brute Force
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SEC=60
BRUTE_FORCE_COOLDOWN_SEC=300

# Credential Stuffing
CRED_STUFFING_THRESHOLD=5
CRED_STUFFING_WINDOW_SEC=60
CRED_STUFFING_COOLDOWN_SEC=300

# Distributed Attack
DISTRIBUTED_THRESHOLD=5
DISTRIBUTED_WINDOW_SEC=60
DISTRIBUTED_COOLDOWN_SEC=300

# Possible Compromise (fail-then-success)
COMPROMISE_FAILED_THRESHOLD=3
COMPROMISE_WINDOW_SEC=120
COMPROMISE_COOLDOWN_SEC=300

# Request Abuse (rate limiting)
REQUEST_ABUSE_THRESHOLD=100
REQUEST_ABUSE_WINDOW_SEC=60
REQUEST_ABUSE_COOLDOWN_SEC=120

# Scanner / Bot Detection (distinct paths)
SCANNER_PATH_THRESHOLD=10
SCANNER_WINDOW_SEC=30
SCANNER_COOLDOWN_SEC=300

# Forbidden Access Probing
FORBIDDEN_PROBE_THRESHOLD=5
FORBIDDEN_PROBE_WINDOW_SEC=60
FORBIDDEN_PROBE_COOLDOWN_SEC=180

# High Error Rate (0.8 = 80% of requests must be 4xx/5xx)
HIGH_ERROR_RATE_THRESHOLD=0.8
HIGH_ERROR_RATE_MIN_REQUESTS=10
HIGH_ERROR_RATE_WINDOW_SEC=60
HIGH_ERROR_RATE_COOLDOWN_SEC=180

# Path Traversal / SQLi cooldowns (signature-based, one-shot)
PATH_TRAVERSAL_COOLDOWN_SEC=300
SQLI_COOLDOWN_SEC=300
